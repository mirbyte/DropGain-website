---
const pillars = [
  {
    title: 'Read the processing chain',
    body: 'Licensed under AGPL-3.0. Gain, limiting, and measurement logic live in the repo — auditable and forkable, not a black box.',
    icon: 'code',
  },
  {
    title: 'Parameters, not presets',
    body: 'Window length, hop size, LUFS targets, true-peak ceiling, gain mode, and export routing stay in your hands.',
    icon: 'sliders',
  },
  {
    title: 'Review before render',
    body: 'Every track is analyzed first. LUFS, dBTP, and suggested gain appear in the table before any batch processing runs.',
    icon: 'table',
  },
];
---

<section class="section" id="open-design">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-label">Open by design</p>
      <h2>Control you can verify</h2>
      <p class="lead">
        Closed prep tools trade transparency for convenience. DropGain is built the other way around.
      </p>
    </div>
    <div class="card-grid card-grid-3">
      {
        pillars.map((pillar) => (
          <article class="glass-card open-card reveal">
            <div class="open-icon" aria-hidden="true">
              {pillar.icon === 'code' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M9 18L3 12l6-6M15 6l6 6-6 6" />
                </svg>
              )}
              {pillar.icon === 'sliders' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 6h16M4 12h10M4 18h6" />
                  <circle cx="18" cy="6" r="2" />
                  <circle cx="14" cy="12" r="2" />
                  <circle cx="10" cy="18" r="2" />
                </svg>
              )}
              {pillar.icon === 'table' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="M3 10h18M9 10v9M15 10v9" />
                </svg>
              )}
            </div>
            <h3>{pillar.title}</h3>
            <p class="text-muted">{pillar.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .open-card h3 {
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg-main);
    margin-bottom: var(--space-2);
  }

  .open-card p {
    margin: 0;
    font-size: 0.9375rem;
  }

  .open-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    color: var(--accent);
    background: var(--accent-dim);
    border-radius: var(--radius-sm);
    border: 1px solid rgb(176 220 232 / 15%);
  }

  .open-icon svg {
    width: 22px;
    height: 22px;
  }
</style>
