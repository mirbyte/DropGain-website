---
const discussionsUrl = 'https://github.com/mirbyte/DropGain/discussions';
const profileUrl = 'https://github.com/mirbyte';
const emptySlots = 3;
---

<section class="section" id="early-adopters">
  <div class="container">
    <div class="adopters-card glass-card reveal">
      <div class="adopters-glow" aria-hidden="true" />
      <div class="adopters-copy">
        <p class="section-label">Early adopters</p>
        <h2>Early adopters wanted</h2>
        <p class="lead">
          No rented quotes or suspicious five-star screenshots — just an empty row until real DJs
          actually use DropGain in their prep workflow.
        </p>
        <p class="text-muted adopters-note">
          If that is you, drop me an <span class="text-accent">email</span> or start a <span class="text-accent">discussion</span> with a short note or before/after result.
          Good feedback may earn a name here later.
        </p>
        <div class="adopters-cta-row">
          <a id="email-btn" class="btn btn-secondary adopters-cta" href="#" data-em="bWlyYnl0ZUBwcm90b24ubWU=">
            Email me
          </a>
          <a class="btn btn-ghost adopters-cta adopters-cta-email" href={discussionsUrl} target="_blank" rel="noopener noreferrer">
            Start a discussion
          </a>
        </div>
      </div>

      <div class="adopters-slots" aria-label="Future early adopters">
        {Array.from({ length: emptySlots }, () => (
          <span class="adopters-avatar adopters-avatar-empty" aria-hidden="true">?</span>
        ))}
        <a
          class="adopters-avatar adopters-avatar-add"
          href={discussionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Start a discussion on GitHub"
        >
          +
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('email-btn');
  if (btn) {
    const em = btn.dataset.em;
    btn.href = 'mailto:' + atob(em);
    btn.removeAttribute('data-em');
  }
</script>

<style>
  .adopters-card {
    position: relative;
    display: grid;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-8);
    overflow: hidden;
  }

  .adopters-glow {
    position: absolute;
    inset: auto -10% -40% auto;
    width: 18rem;
    height: 18rem;
    border-radius: var(--radius-sm);
    background: rgb(176 220 232 / 18%);
    filter: blur(60px);
    opacity: 0.6;
    pointer-events: none;
  }

  .adopters-copy {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .adopters-copy h2 {
    margin-bottom: var(--space-3);
  }

  .adopters-copy .lead {
    margin-bottom: var(--space-4);
  }

  .adopters-note {
    margin: 0 0 var(--space-6);
    font-size: 0.9375rem;
  }

  .adopters-note a {
    color: var(--accent);
  }

  .adopters-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .adopters-cta {
    font-size: 0.875rem;
    padding: 0.625rem 1.25rem;
  }

  .adopters-cta-email {
    border: 1px solid var(--border-glass);
    color: var(--fg-muted);
    background: transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .adopters-cta-email:hover {
    color: var(--accent);
    border-color: rgb(176 220 232 / 40%);
    background: var(--accent-dim);
  }

  .adopters-slots {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .adopters-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 1rem;
    border: 1px solid var(--border-glass);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 6%);
    text-decoration: none;
  }

  .adopters-avatar-empty {
    color: var(--fg-muted);
    background: rgb(255 255 255 / 4%);
  }

  .adopters-avatar-add {
    color: var(--accent);
    background: var(--accent-dim);
    border-color: rgb(176 220 232 / 28%);
    box-shadow: var(--glow-accent-sm);
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .adopters-avatar-add:hover {
    color: var(--accent);
    background: rgb(176 220 232 / 12%);
    border-color: rgb(176 220 232 / 40%);
    box-shadow: var(--glow-accent);
  }

  @media (min-width: 820px) {
    .adopters-card {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: var(--space-8) var(--space-8) var(--space-8) var(--space-8);
    }

    .adopters-slots {
      justify-content: flex-end;
      min-width: 15rem;
    }

    .adopters-avatar {
      width: 3.75rem;
      height: 3.75rem;
    }
  }
</style>
