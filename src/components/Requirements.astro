---
const packagedSetup = [
  { name: 'Windows build', note: 'Run DropGain.exe from the packaged release folder (release/DropGain/ via python build.py, or a published release).' },
  {
    name: 'FFmpeg / ffprobe',
    note: 'Shipped in the app bin/ folder — no PATH install required for the packaged build.',
  },
  {
    name: 'FabFilter Pro-L 2 (VST3) or LoudMax',
    note: 'Only for limiter-assisted mode. Drop LoudMax into plugins/ next to the exe (or use a system VST3 folder), or install Pro-L 2. Analysis and clean-gain render work without a limiter.',
  },
];

const sourceSetup = [
  { name: 'Python 3', note: 'customtkinter, numpy, scipy, pyloudnorm, mutagen, pedalboard, Pillow' },
  {
    name: 'FFmpeg / ffprobe',
    note: 'On PATH, or in a bin/ folder next to the app (same layout as the packaged build).',
  },
  { name: 'Clone and run', note: 'pip install -r requirements.txt, then launch main.pyw.' },
  {
    name: 'Validate in Preferences',
    note: 'Check Limiter / System before batch render (limiter engine detection and toolchain).',
  },
];
---

<section class="section" id="setup">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-label">Setup</p>
      <h2>Packaged Windows build or from source</h2>
      <p class="lead">
        Prefer the packaged build on Windows. FFmpeg ships with the exe; limiter-assisted mode still needs a VST3.
        From-source install works the same once dependencies are on PATH or in <code>bin/</code>.
      </p>
    </div>
    <div class="card-grid card-grid-2">
      <article class="glass-card reveal">
        <h3>Packaged build</h3>
        <ul class="req-list">
          {
            packagedSetup.map((item) => (
              <li>
                <strong>{item.name}</strong>
                <span>{item.note}</span>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="glass-card reveal">
        <h3>From source</h3>
        <ul class="req-list">
          {
            sourceSetup.map((item) => (
              <li>
                <strong>{item.name}</strong>
                <span>{item.note}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <div class="callout-warn setup-callout reveal" role="note">
      <p class="callout-warn-title">Disable playback auto gain before loading <code>_DG</code> exports</p>
      <p class="callout-warn-body">
        Required in Rekordbox, Serato, TRAKTOR, VirtualDJ, and similar software.
        Auto gain will fight the levels DropGain baked in.
        Engine DJ standalone players generally have no playback auto gain, so pre-leveled <code>_DG</code> files are usually fine there.
      </p>
    </div>
  </div>
</section>

<style>
  .req-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .req-list li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .req-list li:last-child {
    border-bottom: none;
  }

  .req-list strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--fg-main);
    margin-bottom: var(--space-1);
  }

  .req-list span {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .setup-callout {
    margin-top: var(--space-8);
  }

  code {
    color: var(--accent);
  }
</style>
