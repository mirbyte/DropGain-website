---
const djSetup = [
  { name: 'Windows', note: 'Tested by the author. macOS/Linux may work but are untested.' },
  { name: 'FFmpeg / ffprobe', note: 'Must be on PATH for analysis and render.' },
  {
    name: 'FabFilter Pro-L 2 (VST3) or LoudMax',
    note: 'Only for limiter-assisted mode. LoudMax is free; Pro-L 2 has a 30-day free trial. Clean gain and full library analysis work without it.',
  },
];

const devSetup = [
  { name: 'Python 3', note: 'customtkinter, numpy, scipy, pyloudnorm, mutagen, pedalboard, Pillow' },
  { name: 'Clone and run', note: 'Launch main.pyw from the app repo after installing dependencies.' },
  {
    name: 'Validate in Preferences',
    note: 'Check Pro-L 2 / LoudMax detection and system dependencies before batch render.',
  },
];
---

<section class="section" id="setup">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-label">Setup</p>
      <h2>Run from source</h2>
      <p class="lead">
        No installer yet — follow the repo README for dependency install, then launch <code>main.pyw</code> and validate your setup in Preferences before rendering.
      </p>
    </div>
    <div class="card-grid card-grid-2">
      <article class="glass-card reveal">
        <h3>What you need</h3>
        <ul class="req-list">
          {
            djSetup.map((item) => (
              <li>
                <strong>{item.name}</strong>
                <span>{item.note}</span>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="glass-card reveal">
        <h3>Developer setup</h3>
        <ul class="req-list">
          {
            devSetup.map((item) => (
              <li>
                <strong>{item.name}</strong>
                <span>{item.note}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <div class="callout-warn setup-callout reveal" role="note">
      <p class="callout-warn-title">Disable playback auto gain before loading <code>_DG</code> exports</p>
      <p class="callout-warn-body">
        This is required in Rekordbox, Serato, TRAKTOR, VirtualDJ, and similar software.
        Auto gain will fight the levels DropGain applied and make your prep unreliable in the booth.
      </p>
    </div>
  </div>
</section>

<style>
  .req-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .req-list li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .req-list li:last-child {
    border-bottom: none;
  }

  .req-list strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--fg-main);
    margin-bottom: var(--space-1);
  }

  .req-list span {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .setup-callout {
    margin-top: var(--space-8);
  }

  code {
    color: var(--accent);
  }
</style>
