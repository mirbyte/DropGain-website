---
import { Image } from 'astro:assets';
import uiLaunch from '../assets/screenshots/ui-launch.png';

const repoUrl = 'https://github.com/mirbyte/DropGain';
---

<section class="hero section" id="top">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <p class="section-label font-ui">Work in progress · Open source · Windows</p>
      <h1>
        Loudness prep for the <span class="hero-accent">drop</span>, not the average.
      </h1>
      <p class="lead">
        DropGain finds the loudest section of your track, lets you set your own LUFS target and true-peak ceiling,
        and renders <code>_DG</code> copies without touching your originals.
        You'll always know how loud the drop actually hits.
      </p>
      <p class="text-small text-muted audience-note">
        For DJs comfortable running from source while builds and limiter support expand.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={repoUrl} target="_blank" rel="noopener noreferrer">
          View on GitHub
        </a>
        <a class="btn btn-secondary" href="#setup">
          Setup guide
        </a>
      </div>
    </div>

    <div class="hero-visual reveal">
      <div class="hero-frame-wrap">
        <div class="hero-frame glass" data-hero-frame>
          <div class="window-chrome" aria-hidden="true">
            <span class="chrome-dot chrome-close" />
            <span class="chrome-dot chrome-min" />
            <span class="chrome-dot chrome-max" />
            <span class="chrome-title">DropGain</span>
          </div>
          <div class="hero-img-wrap">
            <Image
              src={uiLaunch}
              alt="DropGain application showing library analysis table and waveform preview"
              loading="eager"
              widths={[800, 1200, 1600]}
              sizes="(min-width: 960px) 55vw, 100vw"
              data-hero-img
            />
          </div>
          <div class="hero-reflection" aria-hidden="true" />
        </div>

        <div class="meter-card glass" data-meter-card aria-label="Example loudness readouts">
          <p class="meter-card-title readout">SECTION</p>
          <div class="meter-row">
            <span class="meter-label readout">LUFS</span>
            <div class="meter-track"><div class="meter-bar meter-bar-lufs" data-meter-bar style="transform: scaleX(0.72)" /></div>
            <span class="meter-value readout">-7.6</span>
          </div>
          <div class="meter-row">
            <span class="meter-label readout">dBTP</span>
            <div class="meter-track"><div class="meter-bar meter-bar-tp" data-meter-bar style="transform: scaleX(0.58)" /></div>
            <span class="meter-value readout">-1.0</span>
          </div>
          <div class="meter-row">
            <span class="meter-label readout">GAIN</span>
            <div class="meter-track"><div class="meter-bar meter-bar-gain" data-meter-bar style="transform: scaleX(0.85)" /></div>
            <span class="meter-value readout">+1.2</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-12);
    overflow: hidden;
  }

  .hero-copy {
    max-width: 34rem;
  }

  .hero-copy h1 {
    font-size: clamp(2.25rem, 5.5vw, 3.25rem);
    line-height: 1.15;
  }

  .hero-grid {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  .hero-accent {
    background: linear-gradient(135deg, var(--accent-bright), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 20px rgb(176 220 232 / 35%));
  }

  .hero-copy code {
    color: var(--accent);
    background: var(--accent-dim);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .audience-note {
    margin: 0 0 var(--space-6);
  }

  .hero-visual {
    position: relative;
  }

  .hero-frame-wrap {
    position: relative;
  }

  .hero-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-deep);
    transition: transform 0.1s ease-out;
    will-change: transform;
  }

  .window-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: rgb(26 26 26 / 90%);
    border-bottom: 1px solid var(--border);
  }

  .chrome-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .chrome-close { background: #ff5f57; }
  .chrome-min { background: #febc2e; }
  .chrome-max { background: #28c840; }

  .chrome-title {
    margin-left: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
  }

  .hero-img-wrap {
    overflow: hidden;
    line-height: 0;
  }

  .hero-img-wrap :global(img) {
    width: 100%;
    display: block;
  }

  :global(img.ken-burns-active) {
    animation: ken-burns 28s ease-in-out infinite alternate;
  }

  @keyframes ken-burns {
    from { transform: scale(1); }
    to { transform: scale(1.04); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(img.ken-burns-active) {
      animation: none;
    }
  }

  .hero-reflection {
    height: 24px;
    background: var(--bg-field);
    pointer-events: none;
  }

  .meter-card {
    position: absolute;
    bottom: 3rem;
    left: -1rem;
    width: 11.5rem;
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-deep);
    z-index: 2;
  }

  @media (max-width: 959px) {
    .meter-card {
      left: auto;
      right: 0;
      bottom: 1rem;
    }
  }

  .meter-card-title {
    font-size: 0.625rem;
    color: var(--accent);
    margin: 0 0 var(--space-3);
    letter-spacing: 0.1em;
  }

  .meter-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr 2.5rem;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .meter-row:last-child {
    margin-bottom: 0;
  }

  .meter-label {
    font-size: 0.625rem;
    color: var(--fg-muted);
  }

  .meter-track {
    height: 4px;
    background: rgb(255 255 255 / 8%);
    border-radius: 2px;
    overflow: hidden;
  }

  .meter-bar {
    width: 100%;
    height: 100%;
    border-radius: 2px;
    transform-origin: left center;
    will-change: transform;
  }

  .meter-bar-lufs { background: var(--accent); }
  .meter-bar-tp { background: var(--success); }
  .meter-bar-gain { background: var(--warn); }

  .meter-value {
    font-size: 0.6875rem;
    color: var(--fg-main);
    text-align: right;
  }

</style>
