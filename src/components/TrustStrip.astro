---
const djApps = ['Rekordbox', 'Serato', 'TRAKTOR', 'VirtualDJ', 'Mixxx'];
const formats = ['WAV', 'AIFF', 'MP3', 'FLAC'];
---

<section class="trust-strip" aria-label="DropGain compatibility">
  <div class="container trust-strip-inner reveal">
    <p class="trust-kicker">Exports standard audio files for DJ libraries</p>
    <div class="trust-items" aria-label="Supported DJ workflows and audio formats">
      {djApps.map((name) => <span class="trust-pill">{name}</span>)}
      {formats.map((name) => <span class="trust-pill trust-pill-format">{name}</span>)}
    </div>
  </div>
</section>

<style>
  .trust-strip {
    padding-block: var(--space-6);
    border-block: 1px solid var(--border-glass);
    background:
      radial-gradient(ellipse 80% 120% at 50% 50%, rgb(176 220 232 / 5%), transparent 60%),
      rgb(255 255 255 / 2%);
  }

  .trust-strip-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .trust-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    line-height: 1;
  }

  .trust-items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    min-height: 2.125rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border-glass);
    border-radius: 999px;
    background: rgb(255 255 255 / 4%);
    color: var(--fg-main);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 5%);
  }

  .trust-pill-format {
    color: var(--accent);
    background: var(--accent-dim);
    border-color: rgb(176 220 232 / 22%);
  }

  @media (min-width: 800px) {
    .trust-strip-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
    }

    .trust-items {
      justify-content: flex-end;
      flex: 1;
    }
  }
</style>
