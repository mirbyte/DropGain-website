---
const repoUrl = 'https://github.com/mirbyte/DropGain';
---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo font-brand" href="#top">
      DROPGAIN
    </a>
    <nav aria-label="Primary">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
      <ul class="nav-links" id="nav-menu" data-nav-menu>
        <li><a href="#features">Features</a></li>
        <li><a href="#workflow">Workflow</a></li>
        <li><a href="#limitations">Limitations</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="#setup">Setup</a></li>
        <li>
          <a
            class="nav-github"
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View source on GitHub"
          >
            <span class="sr-only">View source on GitHub</span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-nav-menu]');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  const sectionLinks = Array.from(
    menu?.querySelectorAll('a[href^="#"]:not(.btn)') ?? [],
  );
  const sections = sectionLinks
    .map((link) => {
      const id = link.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    })
    .filter(Boolean);

  const setActiveLink = () => {
    const offset = 96;
    let current = '';

    for (const section of sections) {
      if (window.scrollY >= section.offsetTop - offset) {
        current = section.id;
      }
    }

    sectionLinks.forEach((link) => {
      const href = link.getAttribute('href')?.slice(1);
      link.classList.toggle('is-active', href === current);
    });
  };

  setActiveLink();
  window.addEventListener('scroll', setActiveLink, { passive: true });
  window.addEventListener('resize', setActiveLink);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    isolation: isolate;
    background: transparent;
    border-bottom: 1px solid var(--border-glass);
  }

  .nav::before,
  .nav::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Blur layer (behind tint) */
  .nav::before {
    z-index: -2;
    backdrop-filter: blur(40px) brightness(0.88);
    -webkit-backdrop-filter: blur(40px) brightness(0.88);
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      rgb(0 0 0 / 90%) 20%,
      rgb(0 0 0 / 60%) 45%,
      rgb(0 0 0 / 40%) 70%,
      rgb(0 0 0 / 32%) 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      rgb(0 0 0 / 90%) 20%,
      rgb(0 0 0 / 60%) 45%,
      rgb(0 0 0 / 40%) 70%,
      rgb(0 0 0 / 32%) 100%
    );
  }

  /* Opaque tint on top of blur — blur alone won't hide readable text */
  .nav::after {
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgb(24 26 29 / 88%) 0%,
      rgb(24 26 29 / 62%) 45%,
      rgb(24 26 29 / 38%) 100%
    );
  }

  .nav-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 2.4rem;
    font-weight: 400;
    color: var(--accent);
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .logo:hover {
    color: var(--accent-hover);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 4%);
    color: var(--fg-main);
    cursor: pointer;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.35rem 0.45rem;
    color: var(--fg-muted);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .nav-links a:not(.btn):hover {
    color: var(--fg-main);
    background: rgb(255 255 255 / 3%);
  }

  .nav-links a:not(.btn).is-active {
    color: var(--fg-main);
    border-color: var(--accent);
    background: rgb(176 220 232 / 5%);
  }

  .nav-github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: var(--space-2);
    color: var(--fg-muted);
    border: 1px solid var(--border);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .nav-github:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgb(176 220 232 / 5%);
  }

  .nav-github svg {
    display: block;
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: inline-flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-4);
      background: rgb(31 35 39 / 65%);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(32px);
      -webkit-backdrop-filter: blur(32px);
    }

    .nav-links.is-open {
      display: flex;
    }

    .nav-links li {
      padding-block: var(--space-2);
    }

    .nav-github {
      margin-left: 0;
      margin-top: var(--space-2);
    }

    nav {
      position: relative;
    }
  }
</style>
