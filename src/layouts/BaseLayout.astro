---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/cascadia-mono';

const {
  title = 'DropGain — loudness prep for DJs, work in progress',
  description = 'Open-source, section-based loudness prep for DJ libraries. Work in progress on Windows — run from source, set your LUFS targets, review per-track analysis, and render _DG copies.',
} = Astro.props;

const siteUrl = Astro.site?.href ?? 'https://mirbyte.github.io';
const baseUrl = new URL(import.meta.env.BASE_URL, siteUrl).href;
const canonical = new URL(Astro.url.pathname, baseUrl).href;
const ogImage = new URL('og-image.svg', baseUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="1bbeca95-94c4-40a7-bc38-60bcb62e71be" data-domains="dropgain.app"></script>
  </head>
  <body>
    <div class="wave-bg" aria-hidden="true">
      <canvas data-wave-bg class="wave-bg-canvas"></canvas>
    </div>
    <slot />
    <script>
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reduce-motion');
      }
    </script>
    <script type="module">
      import { initMotion } from '../scripts/reveal.js';
      import { initAudioViz } from '../scripts/audio-viz.js';
      import { initCursor } from '../scripts/cursor.js';

      initMotion();
      initAudioViz();
      initCursor();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
